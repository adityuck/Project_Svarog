secnum,1    ! reset the section ID to default
keyo,cid,8,1               ! both symmetric pairs are active and have the same contact characteristics
keyo,cid,10,0              ! adjust contact stiffness each NR iteration (from Program Controlled setting)
keyo,cid,11,1              ! include shell thickness effect
keyo,cid,12,5              ! bonded always
keyo,cid,18,1              ! small sliding turned on by application
keyo,cid,2,2               ! MPC for bonded contacts (from Program Controlled setting)
keyo,tid,5,4               ! Force Distributed Constraint, All Directions
keyo,cid,4,2               ! on nodal point - normal to target surface (from Program Controlled setting)
keyo,cid,9,1               ! ignore initial gaps/penetration
keyo,cid,7,0               ! No Prediction
rmod,tid,3,10.      ! FKN
rmod,tid,5,0.       ! ICONT
rmod,tid,6,0.       ! PINB
rmod,tid,10,0.      ! CNOF
rmod,tid,12,0.      ! FKT
rmod,tid,36,161     ! WB DSID
rmod,cid,3,10.      ! FKN
rmod,cid,5,0.       ! ICONT
rmod,cid,6,0.       ! PINB
rmod,cid,10,0.      ! CNOF
rmod,cid,12,0.      ! FKT
rmod,cid,36,161     ! WB DSID
nsel,all
esel,all
