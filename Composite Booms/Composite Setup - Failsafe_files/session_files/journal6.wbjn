# encoding: utf-8
# 2025 R2
SetScriptVersion(Version="25.2.170")
system1 = GetSystem(Name="ACP-Pre")
setup1 = system1.GetContainer(ComponentName="Setup")
setup1.StartACP(ACPMode="pre")
Parameters.SetDesignPointsOutOfDate()
engineeringData1 = system1.GetContainer(ComponentName="Engineering Data")
system2 = GetSystem(Name="Geom")
geometry1 = system2.GetContainer(ComponentName="Geometry")
model1 = system1.GetContainer(ComponentName="Model")
system3 = GetSystem(Name="SYS")
model2 = system3.GetContainer(ComponentName="Model")
setup2 = system3.GetContainer(ComponentName="Setup")
solution1 = system3.GetContainer(ComponentName="Solution")
results1 = system3.GetContainer(ComponentName="Results")
Parameters.SetRetainedDesignPointDataInvalid(InvalidContainers=[engineeringData1, geometry1, model1, setup1, model2, setup2, solution1, results1])
setupComponent1 = system1.GetComponent(Name="Setup")
modelComponent1 = system3.GetComponent(Name="Model")
setupComponent2 = system3.GetComponent(Name="Setup")
solutionComponent1 = system3.GetComponent(Name="Solution")
resultsComponent1 = system3.GetComponent(Name="Results")
MarkComponentsOutOfDateForDps(Components=[setupComponent1, modelComponent1, setupComponent2, solutionComponent1, resultsComponent1])
Parameters.SetPartiallyRetainedDataInvalid(Containers=[setup1, model2, setup2, solution1, results1])
Save(Overwrite=True)
Save(Overwrite=True)
